---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bio from '../components/Bio.astro';
import Approach from '../components/Approach.astro';
import ContactCTA from '../components/ContactCTA.astro';
---

<BaseLayout
  title="Chi sono — Marco Regalia | RM-Solution"
  description="18 anni di esperienza IT sul campo. Dalla tecnica alla co-fondazione di BlendIT, oggi con RM-Solution porto competenza enterprise alle PMI di Milano e Varese."
>
  <section class="page-hero">
    <div class="container">
      <span class="page-num">— CHI SONO</span>
      <h1>Diciotto anni sul campo. Prima tecnico, poi socio, poi imprenditore.</h1>
    </div>
  </section>

  <Approach />
  <Bio />
  <ContactCTA />
</BaseLayout>

<style>
  .page-hero {
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(48px, 8vw, 96px);
    border-bottom: 0.5px solid var(--rule);
  }
  .page-num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 24px;
  }
  .page-hero h1 {
    font-size: clamp(36px, 6vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin-bottom: 24px;
    max-width: 700px;
  }
  .page-lede {
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 600px;
  }
</style>
