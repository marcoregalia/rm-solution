---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">RM<span>·</span>Solution</div>
        <p class="footer-tag">Direzione tecnica IT per PMI, startup e studi professionali.</p>
      </div>
      <div class="footer-col">
        <div class="footer-col-label">Navigazione</div>
        <ul>
          <li><a href="/servizi/">Servizi</a></li>
          <li><a href="/chi-sono/">Chi sono</a></li>
          <li><a href="/casi-studio/">Casi studio</a></li>
          <li><a href="/contatti/">Contatti</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <div class="footer-col-label">Contatti</div>
        <ul>
          <li><a href="mailto:info@rm-solution.it">info@rm-solution.it</a></li>
          <li>Varese / Milano</li>
          <li><a href="https://www.linkedin.com/in/marcoregalia" rel="noopener" target="_blank">LinkedIn ↗</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <div class="footer-col-label">Legale</div>
        <ul>
          <li><a href="/privacy/">Privacy policy</a></li>
          <li><a href="/cookie/">Cookie policy</a></li>
          <li>P.IVA da inserire</li>
        </ul>
      </div>
    </div>
    <div class="footer-meta">
      <span>© {year} RM-Solution · Marco Regalia</span>
      <span class="mono">v2.0 — built with Astro</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-darker);
    color: #fff;
    padding: 56px 0 32px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }
  .footer-logo {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 12px;
    color: #fff;
  }
  .footer-logo span { color: var(--blue); }
  .footer-tag {
    font-size: 13px;
    color: var(--text-light);
    line-height: 1.6;
    max-width: 300px;
  }
  .footer-col-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-light-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 16px;
    font-weight: 500;
  }
  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .footer-col a, .footer-col li {
    font-size: 13px;
    color: #fff;
    transition: color 0.2s;
  }
  .footer-col a:hover { color: var(--blue); }
  .footer-meta {
    border-top: 0.5px solid var(--rule-dark);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--text-light-muted);
    flex-wrap: wrap;
    gap: 12px;
  }
  .footer-meta .mono {
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px 24px;
    }
    .footer-brand { grid-column: span 2; }
  }
</style>
