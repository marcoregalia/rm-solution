---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">RM<span>·</span>Solution</div>
        <p class="footer-tag">
          Direzione tecnica IT per PMI, startup e studi professionali.
          <br />Marco Regalia, Fractional CTO & Senior IT Advisor.
        </p>
      </div>

      <div class="footer-col">
        <div class="footer-col-label">Navigazione</div>
        <ul>
          <li><a href="/servizi/">Servizi</a></li>
          <li><a href="/chi-sono/">Chi sono</a></li>
          <li><a href="/casi-studio/">Casi studio</a></li>
          <li><a href="/contatti/">Contatti</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <div class="footer-col-label">Contatti</div>
        <ul>
          <li><a href="mailto:info@rm-solution.it">info@rm-solution.it</a></li>
          <li><a href="tel:+393475400385">+39 347 540 0385</a></li>
          <li>21013 Gallarate (VA)</li>
          <li>
            <a href="https://www.linkedin.com/in/marcoregalia79" rel="noopener" target="_blank">
              LinkedIn ↗
            </a>
          </li>
        </ul>
      </div>

      <div class="footer-col">
        <div class="footer-col-label">Legale</div>
        <ul>
          <li>
            <a href="https://www.iubenda.com/privacy-policy/45743030"
               class="iubenda-white iubenda-noiframe iubenda-embed"
               title="Privacy Policy" target="_blank" rel="noopener">
              Privacy policy
            </a>
          </li>
          <li>
            <a href="https://www.iubenda.com/privacy-policy/45743030/cookie-policy"
               class="iubenda-white iubenda-noiframe iubenda-embed"
               title="Cookie Policy" target="_blank" rel="noopener">
              Cookie policy
            </a>
          </li>
          <li>
            <a href="javascript:void(0);" onclick="if(typeof _iub !== 'undefined' && _iub.cs) _iub.cs.api.openPreferences();">
              Preferenze cookie
            </a>
          </li>
          <li><a href="/note-legali/">Note legali</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-legal-block">
      <div class="legal-item">
        <span class="legal-label">Denominazione</span>
        <span class="legal-val">RM-Solution di Regalia Marco</span>
      </div>
      <div class="legal-item">
        <span class="legal-label">Partita IVA</span>
        <span class="legal-val">IT 04098630124</span>
      </div>
      <div class="legal-item">
        <span class="legal-label">Sede</span>
        <span class="legal-val">21013 Gallarate (VA)</span>
      </div>
    </div>

    <div class="footer-meta">
      <span>© {year} RM-Solution di Regalia Marco · Tutti i diritti riservati</span>
      <span class="mono">v2.0 — built with Astro</span>
    </div>
  </div>

  <!-- Loader Iubenda per i link policy in pagina -->
  <script is:inline type="text/javascript">
    (function (w, d) {
      var loader = function () {
        var s = d.createElement("script"),
            tag = d.getElementsByTagName("script")[0];
        s.src = "https://cdn.iubenda.com/iubenda.js";
        tag.parentNode.insertBefore(s, tag);
      };
      if (w.addEventListener) {
        w.addEventListener("load", loader, false);
      } else if (w.attachEvent) {
        w.attachEvent("onload", loader);
      } else {
        w.onload = loader;
      }
    })(window, document);
  </script>
</footer>

<style>
  .site-footer {
    background: var(--bg-darker);
    color: #fff;
    padding: 56px 0 32px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
  }
  .footer-logo {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 12px;
    color: #fff;
  }
  .footer-logo span { color: var(--blue); }
  .footer-tag {
    font-size: 13px;
    color: var(--text-light);
    line-height: 1.6;
    max-width: 320px;
  }
  .footer-col-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-light-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 16px;
    font-weight: 500;
  }
  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-col a, .footer-col li {
    font-size: 13px;
    color: #fff;
    transition: color 0.2s;
  }
  .footer-col a { cursor: pointer; }
  .footer-col a:hover { color: var(--blue); }

  /* Blocco legale */
  .footer-legal-block {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 24px 0;
    margin-bottom: 24px;
    border-top: 0.5px solid var(--rule-dark);
    border-bottom: 0.5px solid var(--rule-dark);
  }
  .legal-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .legal-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-light-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .legal-val {
    font-size: 12px;
    color: var(--text-light);
    font-weight: 500;
  }

  .footer-meta {
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--text-light-muted);
    flex-wrap: wrap;
    gap: 12px;
  }
  .footer-meta .mono {
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px 24px;
    }
    .footer-brand { grid-column: span 2; }
    .footer-legal-block {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
  }
  @media (max-width: 480px) {
    .footer-legal-block {
      grid-template-columns: 1fr;
    }
  }
</style>
