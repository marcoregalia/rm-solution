---
---

<section class="hero dark-section">
  <div class="glow-tr"></div>
  <div class="glow-bl"></div>
  <div class="container">
    <div class="tag-pill">
      <span class="tag-pill-dot"></span>
      <span class="tag-pill-text">Fractional CTO disponibile</span>
    </div>

    <h1>
      Il tuo <span class="accent">partner tecnico</span> per scelte IT che durano.
    </h1>

    <p class="hero-sub">
      Direzione tecnica, cloud ibrido e cybersecurity per PMI, startup e studi
      professionali. Quindici anni di esperienza certificata in un unico punto di contatto.
    </p>

    <div class="hero-cta">
      <a href="/contatti/" class="btn btn-primary">Prenota una call gratuita</a>
      <a href="/chi-sono/" class="btn btn-ghost">Come lavoro →</a>
    </div>

    <div class="hero-stats">
      <div class="stat">
        <div class="stat-n">15+</div>
        <div class="stat-l">anni di esperienza sul campo</div>
      </div>
      <div class="stat">
        <div class="stat-n blue">8</div>
        <div class="stat-l">certificazioni attive verificabili</div>
      </div>
      <div class="stat">
        <div class="stat-n">100%</div>
        <div class="stat-l">lavoro svolto da me, direttamente</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(40px, 6vw, 80px);
  }
  .hero .tag-pill {
    margin-bottom: 24px;
  }
  .hero h1 {
    font-size: clamp(36px, 5.5vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-bottom: 20px;
    max-width: 700px;
  }
  .hero-sub {
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.6;
    color: var(--text-light);
    max-width: 540px;
    margin-bottom: 36px;
  }
  .hero-cta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 56px;
  }
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 0.5px solid var(--rule-dark);
    padding-top: 32px;
  }
  .stat {
    padding-right: 20px;
    border-right: 0.5px solid var(--rule-dark-soft);
  }
  .stat:nth-child(2) { padding-left: 20px; }
  .stat:last-child {
    border-right: none;
    padding-left: 20px;
  }
  .stat-n {
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #fff;
    margin-bottom: 4px;
  }
  .stat-n.blue { color: var(--blue); }
  .stat-l {
    font-size: 12px;
    color: var(--text-light-soft);
    line-height: 1.45;
  }

  @media (max-width: 600px) {
    .hero-stats {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .stat {
      padding: 16px 0 !important;
      border-right: none;
      border-bottom: 0.5px solid var(--rule-dark-soft);
    }
    .stat:last-child { border-bottom: none; }
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-cta .btn { width: 100%; }
  }
</style>
