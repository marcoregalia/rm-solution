---
const services = [
  {
    icon: 'cloud',
    title: 'Infrastruttura & Cloud',
    desc: 'VMware, Proxmox, Azure. Architetture ad alta disponibilità con costi prevedibili.',
  },
  {
    icon: 'shield',
    title: 'Sicurezza & Backup',
    desc: 'WatchGuard, Veeam, Wasabi. Protezione perimetrale e disaster recovery con test documentati.',
  },
  {
    icon: 'cpu',
    title: 'Direzione tecnica',
    desc: 'Fractional CTO, roadmap IT, vendor management. Da 1 a 3 giornate al mese.',
  },
];
---

<section class="section alt" id="servizi">
  <div class="container">
    <span class="section-num">— 02 Servizi</span>
    <h2>Le aree di intervento, <span class="accent">un solo punto di contatto.</span></h2>
    <p class="section-lede">
      Ogni servizio produce risultati misurabili, documentati e ripetibili.
      Niente promesse vaghe, niente report di facciata.
    </p>
    <div class="cards">
      {services.map((s) => (
        <div class="card">
          <div class="card-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              {s.icon === 'cloud' && (
                <path d="M6.657 18c-2.572 0 -4.657 -2.007 -4.657 -4.483c0 -2.475 2.085 -4.482 4.657 -4.482c.393 -1.762 1.794 -3.2 3.675 -3.773c1.88 -.572 3.956 -.193 5.444 1c1.488 1.19 2.162 3.007 1.77 4.769h.99c1.913 0 3.464 1.56 3.464 3.486c0 1.927 -1.551 3.487 -3.465 3.487h-11.878" />
              )}
              {s.icon === 'shield' && (
                <>
                  <path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3" />
                  <path d="M9 12l2 2l4 -4" />
                </>
              )}
              {s.icon === 'cpu' && (
                <>
                  <rect x="5" y="5" width="14" height="14" rx="1" /><path d="M9 9h6v6h-6z" /><path d="M3 10h2" /><path d="M3 14h2" /><path d="M10 3v2" /><path d="M14 3v2" /><path d="M21 10h-2" /><path d="M21 14h-2" /><path d="M14 21v-2" /><path d="M10 21v-2" />
                </>
              )}
            </svg>
          </div>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </div>
      ))}
    </div>
    <div class="cta-row">
      <a href="/servizi" class="cta-link">
        Scopri tutti i servizi
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12,5 19,12 12,19" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 28px;
  }
  .card {
    background: #fff;
    border: 0.5px solid var(--rule);
    border-radius: 12px;
    padding: 28px 24px;
    transition: box-shadow 0.2s, border-color 0.2s;
  }
  .card:hover {
    box-shadow: 0 4px 20px rgba(30, 144, 255, 0.08);
    border-color: rgba(30, 144, 255, 0.3);
  }
  .card-icon {
    width: 44px;
    height: 44px;
    background: var(--blue-bg);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--blue-deep);
    margin-bottom: 16px;
  }
  .card h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 8px;
    letter-spacing: -0.015em;
  }
  .card p {
    font-size: 14px;
    color: var(--text-soft);
    line-height: 1.6;
  }
  .cta-row {
    display: flex;
    justify-content: flex-end;
  }
  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--blue-deep);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: gap 0.2s;
  }
  .cta-link:hover { gap: 10px; }

  @media (max-width: 700px) {
    .cards { grid-template-columns: 1fr; }
    .cta-row { justify-content: flex-start; }
  }
</style>
