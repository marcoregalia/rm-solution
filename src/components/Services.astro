---
export interface Props {
  showAll?: boolean;
}

const { showAll = false } = Astro.props;

const services = [
  {
    icon: 'cpu',
    title: 'Direzione tecnica frazionale',
    desc: 'Da 1 a 3 giornate al mese: roadmap, vendor management, decisioni architetturali, budgeting IT.',
  },
  {
    icon: 'cloud',
    title: 'Cloud ibrido e virtualizzazione',
    desc: 'VMware, Proxmox, Microsoft Azure. Architetture ad alta disponibilità con costi prevedibili.',
  },
  {
    icon: 'shield',
    title: 'Sicurezza perimetrale e governance',
    desc: 'WatchGuard, Fortinet, pfSense. VLAN, MFA, gestione centralizzata endpoint, policy documentate.',
  },
  {
    icon: 'database',
    title: 'Backup e disaster recovery',
    desc: 'Strategia 3-2-1 con immutabilità su Wasabi S3. Test di ripristino trimestrali documentati.',
  },
  {
    icon: 'mail',
    title: 'Email, Microsoft 365 e ambienti ibridi',
    desc: 'Migrazioni Exchange, antispam Libraesva certificato, configurazioni ibride senza interruzioni.',
  },
];
---

<section class="section alt" id="servizi">
  <div class="container">
    <span class="section-num">— 02 Servizi</span>
    <h2>Cinque aree, <span class="accent">un solo punto di contatto.</span></h2>
    <p class="section-lede">
      Ogni servizio produce risultati misurabili, documentati e ripetibili.
      Niente promesse vaghe, niente report di facciata.
    </p>
    <div class="services-list">
      {services.map((s) => (
        <article class="svc-row">
          <div class="svc-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              {s.icon === 'cpu' && (
                <>
                  <rect x="5" y="5" width="14" height="14" rx="1" /><path d="M9 9h6v6h-6z" /><path d="M3 10h2" /><path d="M3 14h2" /><path d="M10 3v2" /><path d="M14 3v2" /><path d="M21 10h-2" /><path d="M21 14h-2" /><path d="M14 21v-2" /><path d="M10 21v-2" />
                </>
              )}
              {s.icon === 'cloud' && (
                <>
                  <path d="M6.657 18c-2.572 0 -4.657 -2.007 -4.657 -4.483c0 -2.475 2.085 -4.482 4.657 -4.482c.393 -1.762 1.794 -3.2 3.675 -3.773c1.88 -.572 3.956 -.193 5.444 1c1.488 1.19 2.162 3.007 1.77 4.769h.99c1.913 0 3.464 1.56 3.464 3.486c0 1.927 -1.551 3.487 -3.465 3.487h-11.878" />
                </>
              )}
              {s.icon === 'shield' && (
                <>
                  <path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3" /><path d="M9 12l2 2l4 -4" />
                </>
              )}
              {s.icon === 'database' && (
                <>
                  <ellipse cx="12" cy="6" rx="8" ry="3" /><path d="M4 6v6a8 3 0 0 0 16 0v-6" /><path d="M4 12v6a8 3 0 0 0 16 0v-6" />
                </>
              )}
              {s.icon === 'mail' && (
                <>
                  <rect x="3" y="5" width="18" height="14" rx="2" /><polyline points="3,7 12,13 21,7" />
                </>
              )}
            </svg>
          </div>
          <div class="svc-content">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
          <div class="svc-arrow" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12,5 19,12 12,19" />
            </svg>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-list {
    border-top: 0.5px solid var(--rule);
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    border: 0.5px solid var(--rule);
  }
  .svc-row {
    display: grid;
    grid-template-columns: 56px 1fr 24px;
    gap: 16px;
    align-items: center;
    padding: 20px 22px;
    border-bottom: 0.5px solid var(--rule);
    transition: background 0.2s;
  }
  .svc-row:last-child { border-bottom: none; }
  .svc-row:hover { background: var(--bg-soft); }

  .svc-icon {
    width: 40px;
    height: 40px;
    background: var(--blue-bg);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--blue-deep);
    flex-shrink: 0;
  }
  .svc-content h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 4px;
    letter-spacing: -0.012em;
  }
  .svc-content p {
    font-size: 13px;
    color: var(--text-soft);
    line-height: 1.5;
  }
  .svc-arrow { color: var(--blue); display: flex; }

  @media (max-width: 600px) {
    .svc-row {
      grid-template-columns: 40px 1fr;
      padding: 16px;
    }
    .svc-arrow { display: none; }
  }
</style>
