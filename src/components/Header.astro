---
/**
 * Header.astro — aggiornato con Logo SVG inline
 * 
 * MODIFICHE rispetto alla versione precedente:
 *   1. Import del componente Logo
 *   2. Sostituita immagine/testo con <Logo variant="dark" height={44} />
 *   3. Rimossi stili logo precedenti, aggiunti nuovi
 *
 * Il resto dell'header (nav links, hamburger mobile, sticky) rimane invariato.
 * Adatta il markup della nav al tuo HTML reale se differisce.
 */
import Logo from './Logo.astro';

const navLinks = [
  { href: '/',           label: 'Home'       },
  { href: '/chi-sono',   label: 'Chi sono'   },
  { href: '/servizi',    label: 'Servizi'    },
  { href: '/casi-studio',label: 'Casi studio'},
  { href: '/contatti',   label: 'Contatti'   },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="header-inner">

    <!-- ── Logo ── -->
    <a href="/" class="logo-link" aria-label="RM-Solution — torna alla homepage">
      <Logo variant="dark" height={44} />
    </a>

    <!-- ── Nav desktop ── -->
    <nav class="main-nav" aria-label="Navigazione principale">
      <ul class="nav-list">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={['nav-link', { 'is-active': currentPath === href || (href !== '/' && currentPath.startsWith(href)) }]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- ── CTA button ── -->
    <a href="/contatti" class="header-cta">Contattami</a>

    <!-- ── Hamburger mobile ── -->
    <button class="hamburger" id="hamburger" aria-label="Apri menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- ── Mobile menu ── -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Menu mobile">
      <ul>
        {navLinks.map(({ href, label }) => (
          <li><a href={href} class:list={['mobile-nav-link', { 'is-active': currentPath === href }]}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  /* ── Layout ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #ffffff;
    border-bottom: 1px solid #e8eaf0;
    box-shadow: 0 1px 8px rgba(27, 28, 48, 0.06);
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 72px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* ── Logo ── */
  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  /* ── Nav desktop ── */
  .main-nav {
    flex: 1;
  }

  .nav-list {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: block;
    padding: 0.45rem 0.85rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: #3a3d5c;
    text-decoration: none;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
    letter-spacing: 0.01em;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: #3a6fb5;
    background: rgba(58, 111, 181, 0.08);
  }

  .nav-link.is-active {
    font-weight: 600;
  }

  /* ── CTA ── */
  .header-cta {
    flex-shrink: 0;
    padding: 0.5rem 1.25rem;
    background: #1b1c30;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.15s, transform 0.1s;
  }

  .header-cta:hover {
    background: #3a6fb5;
    transform: translateY(-1px);
  }

  /* ── Hamburger ── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    margin-left: auto;
  }

  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: #1b1c30;
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  /* ── Mobile menu ── */
  .mobile-menu {
    background: #fff;
    border-top: 1px solid #e8eaf0;
    padding: 1rem 1.5rem 1.5rem;
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.7rem 0.5rem;
    font-size: 1rem;
    font-weight: 500;
    color: #3a3d5c;
    text-decoration: none;
    border-bottom: 1px solid #f0f1f5;
  }

  .mobile-nav-link.is-active {
    color: #3a6fb5;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .main-nav,
    .header-cta {
      display: none;
    }

    .hamburger {
      display: flex;
    }
  }
</style>

<script>
  const btn  = document.getElementById('hamburger');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.hidden === false;
    if (menu) menu.hidden = isOpen;
    btn?.setAttribute('aria-expanded', String(!isOpen));
    btn?.setAttribute('aria-label', isOpen ? 'Apri menu' : 'Chiudi menu');
  });
</script>
