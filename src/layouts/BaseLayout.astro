---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
}

const {
  title,
  description,
  image = '/og-image.png',
  canonical,
} = Astro.props;

const canonicalURL = canonical
  ? new URL(canonical, Astro.site)
  : new URL(Astro.url.pathname, Astro.site);

const siteName = 'RM-Solution';
const fullTitle = title.includes(siteName) ? title : `${title} — ${siteName}`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0c1424" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon"  href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon"          href="/favicon-512.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={new URL(image, Astro.site)} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale"      content="it_IT" />
    <meta property="og:site_name"   content={siteName} />

    <!-- Twitter -->
    <meta property="twitter:card"        content="summary_large_image" />
    <meta property="twitter:url"         content={canonicalURL} />
    <meta property="twitter:title"       content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image"       content={new URL(image, Astro.site)} />

    <!-- Schema.org LocalBusiness + ProfessionalService -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["LocalBusiness", "ProfessionalService"],
      "name": "RM-Solution",
      "legalName": "RM-Solution di Regalia Marco",
      "url": "https://www.rm-solution.it",
      "logo": "https://www.rm-solution.it/logo.png",
      "image": "https://www.rm-solution.it/og-image.png",
      "telephone": "+39 347 540 0385",
      "email": "info@rm-solution.it",
      "priceRange": "€€",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Gallarate",
        "addressRegion": "VA",
        "postalCode": "21013",
        "addressCountry": "IT"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 45.8206,
        "longitude": 8.8257
      },
      "founder": {
        "@type": "Person",
        "name": "Marco Regalia",
        "jobTitle": "Senior System Administrator",
        "sameAs": ["https://www.linkedin.com/in/marcoregalia"]
      },
      "employee": {
        "@type": "Person",
        "name": "Marco Regalia",
        "jobTitle": "Senior System Administrator"
      },
      "vatID": "IT04098630124",
      "areaServed": ["Milano", "Varese", "Monza", "Brianza", "Lombardia"],
      "knowsAbout": [
        "VMware", "Proxmox", "WatchGuard", "MikroTik", "Wasabi",
        "Cloud Computing", "Virtualization", "Cybersecurity",
        "Disaster Recovery", "Microsoft Azure", "Fractional CTO", "IT Consulting"
      ]
    })} />

    <!-- Iubenda Cookie Solution con Autoblocking -->
    <script is:inline type="text/javascript">
      var _iub = _iub || [];
      _iub.csConfiguration = {
        "askConsentAtCookiePolicyUpdate": true,
        "emailMarketing": { "theme": "dark" },
        "floatingPreferencesButtonDisplay": "bottom-left",
        "perPurposeConsent": true,
        "siteId": 4226928,
        "storage": { "useSiteId": true },
        "whitelabel": false,
        "cookiePolicyId": 45743030,
        "banner": {
          "acceptButtonDisplay": true,
          "closeButtonRejects": true,
          "customizeButtonDisplay": true,
          "explicitWithdrawal": true,
          "listPurposes": true,
          "position": "float-top-center",
          "showTitle": false
        }
      };
      _iub.csLangConfiguration = {
        "it": { "cookiePolicyId": 45743030 }
      };
    </script>
    <script is:inline type="text/javascript" src="https://cs.iubenda.com/autoblocking/4226928.js"></script>
    <script is:inline type="text/javascript" src="//cdn.iubenda.com/cs/iubenda_cs.js" charset="UTF-8" async></script>

    <!-- Google Analytics 4 — bloccato da Iubenda autoblocking fino al consenso -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P6X8826TVQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-P6X8826TVQ', { 'anonymize_ip': true });
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
